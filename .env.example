# =============================================================
# Hospitium - Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to source control.
# =============================================================

# ─────────────────────────────────────────────
# JWT (shared across all services)
# ─────────────────────────────────────────────
JWT_KEY=YOUR_SECRET_JWT_KEY_MIN_32_CHARS_HERE
JWT_ISSUER=Hospitium
JWT_AUDIENCE=HospitiumUsers

# ─────────────────────────────────────────────
# RabbitMQ (shared across all services)
# ─────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─────────────────────────────────────────────
# SQL Server Connection Strings
# ─────────────────────────────────────────────
AUTH_DB_CONNECTION=Server=.\sqlexpress;Initial Catalog=HospitiumAuthDb;Integrated Security=True;Trust Server Certificate=True
BOOKING_DB_CONNECTION=Server=.\sqlexpress;Initial Catalog=HospitiumBookingDb;Integrated Security=True;Trust Server Certificate=True
HOTEL_DB_CONNECTION=Server=.\sqlexpress;Initial Catalog=HospitiumHotelDb;Integrated Security=True;Trust Server Certificate=True
REVIEW_DB_CONNECTION=Server=.\sqlexpress;Initial Catalog=HospitiumReviewDb;Integrated Security=True;Trust Server Certificate=True

# ─────────────────────────────────────────────
# SMTP (NotificationService)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here

# ─────────────────────────────────────────────
# Angular Frontend
# ─────────────────────────────────────────────
ANGULAR_API_BASE_URL=http://localhost:5000
