{
  "Routes": [

    // 🔐 AUTH SERVICE (PUBLIC)
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // ============================
    // 🏨 HOTEL SERVICE — PUBLIC
    // ============================

    {
      "DownstreamPathTemplate": "/api/hotels",
      "UpstreamPathTemplate": "/hotels",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ]
    },
    {
      "DownstreamPathTemplate": "/api/hotels/{id}",
      "UpstreamPathTemplate": "/hotels/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ]
    },
    {
      "DownstreamPathTemplate": "/api/hotels/{id}/rooms",
      "UpstreamPathTemplate": "/hotels/{id}/rooms",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ]
    },

    // ============================
    // 🏨 HOTEL SERVICE — MANAGER
    // ============================

    {
      "DownstreamPathTemplate": "/api/hotels",
      "UpstreamPathTemplate": "/hotels",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/hotels/my",
      "UpstreamPathTemplate": "/hotels/my",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    // Rooms (Manager)

    {
      "DownstreamPathTemplate": "/api/hotels/rooms",
      "UpstreamPathTemplate": "/hotels/rooms",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/hotels/rooms/{roomId}",
      "UpstreamPathTemplate": "/hotels/rooms/{roomId}",
      "UpstreamHttpMethod": [ "PUT" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    // ============================
    // ⭐ HOTEL RATING
    // ============================

    {
      "DownstreamPathTemplate": "/api/hotels/{id}/rate",
      "UpstreamPathTemplate": "/hotels/{id}/rate",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    // ============================
    // 🛠️ ADMIN ROUTES
    // ============================

    {
      "DownstreamPathTemplate": "/api/hotels/approved",
      "UpstreamPathTemplate": "/hotels/approved",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/hotels/pending",
      "UpstreamPathTemplate": "/hotels/pending",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/hotels/{id}",
      "UpstreamPathTemplate": "/hotels/{id}",
      "UpstreamHttpMethod": [ "PUT", "DELETE" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    // ============================
    // 📦 BOOKING SERVICE
    // ============================

    {
      "DownstreamPathTemplate": "/api/bookings/{everything}",
      "UpstreamPathTemplate": "/bookings/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5003
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }

  ],

  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}